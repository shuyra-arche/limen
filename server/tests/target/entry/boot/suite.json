{
  "id": "boot-handoff",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/address.rs",
    "server/src/metal/boot/mod.rs",
    "server/src/metal/boot/major.rs",
    "server/src/metal/boot/trap.rs",
    "server/src/metal/firmware/mod.rs",
    "server/src/metal/firmware/map.rs",
    "server/src/entry/boot/**",
    "server/src/metal/allocator/**",
    "server/src/metal/mmu/internal/access.rs",
    "server/src/metal/mmu/internal/mod.rs",
    "server/src/metal/mmu/internal/riscv/mod.rs",
    "server/src/metal/mmu/internal/riscv/description.rs",
    "server/src/metal/execution/**",
    "server/src/metal/hart/description.rs",
    "server/src/metal/time/**",
    "server/src/metal/mmu/mod.rs",
    "server/src/metal/identity/**",
    "server/src/metal/boot/riscv/**",
    "server/src/metal/firmware/sbi/**",
    "server/link.x",
    "server/src/metal/boot/console.rs",
    "server/src/metal/boot/services.rs",
    "server/src/metal/firmware/devicetree/**",
    "server/src/metal/fdt.rs",
    "server/src/metal/firmware/facts.rs",
    "server/src/metal/hart/stack.rs",
    "server/src/metal/hart/mod.rs",
    "server/src/metal/hart/hardware.rs",
    "server/src/metal/hart/node.rs",
    "server/src/metal/hart/protection.rs",
    "server/src/metal/hart/riscv.rs",
    "server/src/metal/sync/**",
    "server/src/basis/pend.rs",
    "server/tests/target/entry/synchronization.rs",
    "server/tests/target/entry/memory.rs",
    "server/tests/target/entry/foundation.rs",
    "server/tests/target/entry/pool.rs"
  ],
  "run": {
    "kind": "qemu",
    "kernel": "boot-handoff",
    "expects": [
      "PASS firmware-discovery rv64 hart=1 mmu=1 isa=1 timebase=1 sbi=1",
      "PASS synchronization",
      "PASS allocator source=1 negative=1 delayed=1 return=1",
      "PASS typed-pool mapped=1 slots=1 reuse=1 joint=1 stable=1 refund=1",
      "PASS bootstrap-foundation pend=1 pool=1 retained=1 refund=1 generation=1 stale=1 revoked=1",
      "PASS foundation-pressure preflight=1 fragments=1 allocation=1 pool=1 history=1 rediscover=1 shut=1",
      "PASS boot-mapped-storage identity=1 range=1 rw=1 reuse=1",
      "PASS boot-handoff firmware-hart=1 bare=1 masked=1 trap=1 stacks=1 bss=1 fdt=1 ram=1 reserved=1 exclusions=1 regions=0 roots=0"
    ]
  }
}
