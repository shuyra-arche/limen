  "run": {
    "kind": "qemu",
    "kernel": "rv64-iommu",
    "machine": "iommu",
    "harts": 1,
    "expects": [
      "PASS riscv-iommu sv39=1 directory=1 replacement-rejected=1 off=1 fences=130 walk=1 fault=1 dma=1 downgrade=1"
    ],
    "imports": [
      "target/entry/pci"
    ]
  }
