{
  "id": "kernel-execution-harts",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/entry/platform/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/minor.rs",
    "server/src/metal/firmware/**",
    "server/src/entry/boot/**",
    "server/src/metal/riscv/mod.rs",
    "server/src/metal/riscv/boot/**",
    "server/src/metal/riscv/firmware/**",
    "server/link.x",
    "server/src/basis/**",
    "server/src/entry/execution.rs",
    "server/src/metal/riscv/execution/**",
    "server/src/metal/console.rs",
    "server/src/metal/stack.rs"
  ],
  "run": {
    "kind": "qemu",
    "kernel": "kernel-execution-harts",
    "expects": [
      "PASS kernel-execution-harts active=2 affinity=1 pending=1 migrated=1 registers=12 stale=1 ended=3 rollback=1"
    ],
    "distinct": {
      "pattern": "(?m)^OBSERVED kernel-execution-harts hart=([0-9]+)\\r?$",
      "count": 2
    }
  }
}
