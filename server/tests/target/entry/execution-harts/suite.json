{
  "id": "kernel-execution-harts",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/boot/minor.rs",
    "server/src/metal/boot/mod.rs",
    "server/src/metal/boot/major.rs",
    "server/src/metal/boot/trap.rs",
    "server/src/metal/firmware/mod.rs",
    "server/src/metal/firmware/map.rs",
    "server/src/metal/firmware/acpi/**",
    "server/src/entry/boot/**",
    "server/src/metal/boot/riscv/**",
    "server/src/metal/firmware/sbi/**",
    "server/link.x",
    "server/src/basis/**",
    "server/src/metal/identity/**",
    "server/src/metal/sync/**",
    "server/src/metal/execution/riscv/**",
    "server/src/metal/boot/console.rs",
    "server/src/metal/boot/services.rs",
    "server/src/metal/firmware/devicetree/**",
    "server/src/devicetree/**",
    "server/src/metal/firmware/facts.rs",
    "server/src/metal/hart/mod.rs",
    "server/src/metal/hart/local/**",
    "server/src/metal/hart/riscv/description.rs",
    "server/src/metal/hart/riscv/mod.rs",
    "server/src/metal/hart/riscv/native.rs",
    "server/src/metal/execution/mod.rs",
    "server/src/metal/execution/cooperative.rs"
  ],
  "run": {
    "kind": "qemu",
    "kernel": "kernel-execution-harts",
    "expects": [
      "PASS kernel-execution-harts active=2 turn=1 snap=1 affinity=1 pending=1 migrated=1 registers=12 stale=1 ended=3 rollback=1"
    ],
    "distinct": {
      "pattern": "(?m)^OBSERVED kernel-execution-harts hart=([0-9]+)\\r?$",
      "count": 2
    }
  }
}
