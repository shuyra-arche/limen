        "server/src/metal/platform/boot/aarch64/mod.rs",
        "server/src/metal/platform/firmware/psci/**",
        "server/src/metal/processor/hart/aarch64/**",
        "server/tests/target/entry/module/arm_mapping.rs",
        "server/tests/target/entry/module/board/aarch64.rs",
        "server/tests/target/entry/platforms/devicetree.rs",
        "server/tests/target/entry/platforms/pl011.rs"
