      "q35": [
        "server/src/metal/platform/boot/x86_64/major.rs",
        "server/src/metal/platform/boot/x86_64/mod.rs",
        "server/src/metal/processor/hart/x86_64.rs",
        "server/tests/target/entry/module/board/x86_64.rs",
