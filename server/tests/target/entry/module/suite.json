{
  "id": "module-execution",
  "profiles": ["debug", "release"],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/entry/boot/**",
    "server/src/metal/mod.rs",
    "server/src/metal/module/**",
    "server/src/metal/mmu/mod.rs",
    "server/src/metal/mmu/internal/mod.rs",
    "server/src/metal/mmu/internal/access.rs",
    "server/src/metal/boot/mod.rs",
    "server/src/metal/boot/console.rs",
    "server/src/metal/boot/major.rs",
    "server/src/metal/boot/services.rs",
    "server/src/metal/boot/trap.rs",
    "server/src/metal/firmware/mod.rs",
    "server/src/metal/firmware/map.rs",
    "server/src/metal/firmware/acpi/**",
    "server/src/metal/firmware/devicetree/**",
    "server/src/metal/fdt.rs",
    "server/src/metal/firmware/facts.rs",
    "server/src/metal/firmware/uefi/**",
    "server/src/metal/hart/mod.rs",
    "server/src/metal/hart/hardware.rs",
    "server/src/metal/hart/node.rs",
    "server/src/metal/hart/protection.rs",
    "server/src/metal/hart/stack.rs",
    "server/src/metal/sync/**",
    "server/tests/metal/module/fixture.rs",
    "server/tests/metal/module/probe.rs"
  ],
  "run": {
    "kind": "board-boot",
    "boards": ["q35", "virt"],
    "harts": 1,
    "board_sources": {
      "q35": [
        "server/src/metal/boot/x86_64/major.rs",
        "server/src/metal/boot/x86_64/mod.rs",
        "server/src/metal/hart/x86_64.rs",
        "server/tests/target/entry/module/board/x86_64.rs",
        "server/tests/target/entry/module/x86_mapping.rs"
      ],
      "virt": [
        "server/src/metal/boot/aarch64/major.rs",
        "server/src/metal/boot/aarch64/mod.rs",
        "server/src/metal/firmware/psci.rs",
        "server/src/metal/hart/aarch64.rs",
        "server/tests/target/entry/module/arm_mapping.rs",
        "server/tests/target/entry/module/board/aarch64.rs",
        "server/tests/target/entry/platforms/devicetree.rs",
        "server/tests/target/entry/platforms/pl011.rs"
      ]
    }
  }
}
