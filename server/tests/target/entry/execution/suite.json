{
  "id": "kernel-execution",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/generic/mod.rs",
    "server/src/metal/generic/firmware/mod.rs",
    "server/src/metal/generic/firmware/uefi.rs",
    "server/src/entry/boot/**",
    "server/src/metal/riscv/mod.rs",
    "server/src/metal/riscv/boot/**",
    "server/src/metal/generic/firmware/sbi/**",
    "server/link.x",
    "server/src/basis/**",
    "server/src/entry/execution.rs",
    "server/src/metal/riscv/execution/**",
    "server/src/metal/generic/console.rs",
    "server/src/metal/generic/services.rs",
    "server/src/metal/generic/devicetree.rs",
    "server/src/metal/generic/stack.rs"
  ],
  "run": {
    "kind": "qemu",
    "kernel": "kernel-execution",
    "expects": [
      "PASS kernel-execution stacks=2 resume=1 leave=4 ended=4 reuse=1 stale=1 busy=1 rejected_before_occupy=1 dormant_reaped=1"
    ]
