{
  "id": "kernel-execution",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/memory/mod.rs",
    "server/src/metal/platform/mod.rs",
    "server/src/metal/processor/mod.rs",
    "server/src/metal/platform/boot/mod.rs",
    "server/src/metal/platform/boot/major.rs",
    "server/src/metal/platform/boot/trap.rs",
    "server/src/metal/platform/description/mod.rs",
    "server/src/metal/platform/firmware/mod.rs",
    "server/src/metal/platform/firmware/uefi/map.rs",
    "server/src/metal/platform/description/acpi/**",
    "server/src/entry/boot/**",
    "server/src/metal/platform/boot/riscv/**",
    "server/src/metal/platform/firmware/sbi/**",
    "server/link.x",
    "server/src/basis/**",
    "server/src/metal/sync/**",
    "server/src/metal/memory/allocator/**",
    "server/src/metal/memory/mmu/internal/access.rs",
    "server/src/metal/memory/mmu/internal/mod.rs",
    "server/src/metal/memory/mmu/mod.rs",
    "server/src/metal/identity/**",
    "server/tests/target/entry/memory.rs",
    "server/tests/target/entry/pool.rs",
    "server/src/metal/processor/execution/description/mod.rs",
    "server/src/metal/processor/execution/description/riscv.rs",
    "server/src/metal/processor/execution/cooperative/riscv/**",
    "server/src/metal/platform/boot/console.rs",
    "server/src/metal/platform/boot/services.rs",
    "server/src/metal/platform/description/devicetree/**",
    "server/src/metal/devicetree/**",
    "server/src/metal/platform/boot/handoff/mod.rs",
    "server/src/metal/processor/hart/mod.rs",
    "server/src/metal/processor/hart/local/**",
    "server/src/metal/processor/hart/riscv/description.rs",
    "server/src/metal/processor/hart/riscv/mod.rs",
    "server/src/metal/processor/hart/riscv/native.rs",
    "server/src/metal/processor/execution/mod.rs",
    "server/src/metal/processor/execution/cooperative/mod.rs",
    "server/src/metal/platform/firmware/uefi/mod.rs",
    "server/src/metal/platform/boot/handoff/sbi.rs",
    "server/src/metal/processor/hart/riscv/status.rs",
    "server/src/metal/interrupt/mod.rs",
    "server/src/metal/interrupt/internal/mod.rs",
    "server/src/metal/interrupt/internal/supervisor.rs",
    "server/src/metal/memory/mmu/internal/riscv/mod.rs",
    "server/src/metal/memory/mmu/internal/riscv/context/**",
    "server/src/metal/memory/mmu/internal/riscv/mode.rs"
  ],
  "run": {
    "kind": "qemu",
    "kernel": "kernel-execution",
    "expects": [
      "PASS pool value-bytes=512 value-align=64 unit-stack=1",
      "PASS kernel-execution stacks=2 resume=1 leave=4 ended=4 reuse=1 stale=1 busy=1 rejected_before_occupy=1 dormant_reaped=1 buddy_edits=1 binding_returned=1 admission=1",
      "PASS native-control fs=1 source-mask=1 restored=1"
    ]
  }
}
