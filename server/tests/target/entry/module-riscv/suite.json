  "run": {
    "kind": "qemu",
    "kernel": "module-riscv",
    "harts": 2,
    "expects": [
      "PASS riscv-module-execution virt modes=sv39,sv48,sv57 high-leaves=12 geometry=4096 linked=2 roots=2 harts=2 remote-sync=1 remote-typed=2 dependency=1 retired=2 reuse=2",
      "PASS local-context original=1 installed=1 restored=1"
    ]
  }
