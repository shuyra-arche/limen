{
  "id": "platform-boot",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/entry/boot/**",
    "server/src/entry/mod.rs",
    "server/src/lib.rs",
    "server/src/metal/platform/description/devicetree/**",
    "server/src/metal/platform/description/treaty/mod.rs",
    "server/src/metal/platform/description/treaty/devicetree.rs",
    "server/src/metal/identity/**",
    "server/src/metal/memory/allocator/**",
    "server/src/metal/memory/access/**",
    "server/src/metal/memory/mmu/mod.rs",
    "server/src/metal/memory/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/processor/execution/mod.rs",
    "server/src/metal/processor/execution/terminal/mod.rs",
    "server/src/metal/processor/execution/terminal/console.rs",
    "server/src/metal/processor/execution/terminal/trap.rs",
    "server/src/metal/processor/executor/entry/mod.rs",
    "server/src/metal/platform/boot/treaty/mod.rs",
    "server/src/metal/platform/boot/handoff/mod.rs",
    "server/src/metal/platform/boot/handoff/uefi.rs",
    "server/src/metal/platform/boot/major.rs",
    "server/src/metal/processor/executor/launch/mod.rs",
    "server/src/metal/platform/boot/mod.rs",
    "server/src/metal/platform/description/acpi/mod.rs",
    "server/src/metal/platform/description/treaty/acpi.rs",
    "server/src/metal/platform/description/mod.rs",
    "server/src/metal/platform/firmware/mod.rs",
    "server/src/metal/platform/firmware/uefi/**",
    "server/src/metal/platform/firmware/treaty/mod.rs",
    "server/src/metal/platform/firmware/treaty/map.rs",
    "server/src/metal/platform/firmware/uefi/map.rs",
    "server/src/metal/platform/firmware/uefi/mod.rs",
    "server/src/metal/platform/mod.rs",
    "server/src/metal/processor/executor/local/**",
    "server/src/metal/processor/executor/mod.rs",
    "server/src/metal/processor/treaty/mod.rs",
    "server/src/metal/processor/mod.rs",
    "server/src/metal/sync/**",
    "server/tests/target/entry/foundation.rs",
    "server/tests/target/entry/memory.rs",
    "server/tests/target/entry/synchronization.rs",
    "server/tests/target/support/uefi/Cargo.toml",
    "server/tests/target/support/uefi/build.rs",
    "server/src/basis/mod.rs",
    "server/src/basis/pend.rs",
    "server/tests/target/Cargo.toml",
    "server/tests/target/Cargo.lock",
    "server/tests/target/support/uefi/lib.rs"
  ],
  "run": {
    "kind": "board-boot",
    "boards": [
      "q35",
      "virt"
    ],
    "launcher": "support/uefi/run.sh",
    "board_sources": {
      "q35": [
        "server/src/metal/processor/executor/entry/x86_64.rs",
        "server/src/metal/processor/execution/terminal/x86_64.rs",
        "server/src/metal/platform/boot/x86_64/**",
        "server/src/metal/processor/executor/launch/x86_64.rs",
        "server/src/metal/processor/executor/x86_64/**",
        "server/src/metal/processor/description/x86_64/mod.rs",
        "server/src/metal/processor/description/x86_64/status.rs",
        "server/tests/target/support/uefi/q35.rs",
        "server/tests/target/support/uefi/io.rs",
        "server/src/metal/interrupt/x86_64/internal/apic/**",
        "server/src/metal/interrupt/x86_64/mod.rs",
        "server/src/metal/interrupt/x86_64/internal/mod.rs",
        "server/src/metal/interrupt/mod.rs",
        "server/src/metal/platform/description/acpi/madt.rs"
      ],
      "virt": [
        "server/src/metal/processor/executor/entry/aarch64.rs",
        "server/src/metal/processor/execution/terminal/aarch64.rs",
        "server/src/metal/platform/boot/aarch64/**",
        "server/src/metal/processor/executor/launch/aarch64.rs",
        "server/src/metal/platform/firmware/psci/**",
        "server/src/metal/platform/firmware/treaty/psci.rs",
        "server/src/metal/processor/executor/aarch64/**",
        "server/src/metal/processor/description/aarch64/cpu.rs",
        "server/src/metal/processor/description/aarch64/mod.rs",
        "server/src/metal/processor/description/aarch64/status.rs",
        "server/tests/target/support/uefi/virt.rs",
        "server/tests/target/support/uefi/devicetree.rs",
        "server/tests/target/support/uefi/pl011.rs",
        "server/src/metal/interrupt/aarch64/gic/**",
        "server/src/metal/interrupt/aarch64/timer/**",
        "server/src/metal/interrupt/aarch64/mod.rs",
        "server/src/metal/interrupt/mod.rs",
        "server/src/metal/chrono/aarch64/**",
        "server/src/metal/chrono/mod.rs"
      ]
    },
    "launch": {
      "q35": {
        "expects": [
          "PASS firmware-discovery q35 acpi=1 madt=1 routes=1 retained=1",
          "PASS q35 major=1 minor=1 ebs=1 cpl0=1 paging=1 masked=1 stack=1 idt=1",
          "PASS local-apic startup=1 scope-rejected=1 target-rejected=1",
          "PASS early physical exclusions regions=0 roots=0",
          "PASS synchronization",
          "PASS allocator retained without retirement or mapping",
          "PASS bootstrap-foundation pend=1 pool=1 retained=1 refund=1 generation=1 stale=1 revoked=1",
          "PASS foundation-pressure preflight=1 fragments=1 allocation=1 pool=1 history=1 rediscover=1 shut=1",
          "PASS boot-mapped-storage identity=1 range=1 rw=1 reuse=1"
        ]
      },
      "virt": {
        "expects": [
          "PASS firmware-discovery virt dtb=1 psci=1 affinity=1 gic=1 timer=1",
          "PASS virt major=1 minor=1 ebs=1 el1=1 masked=1 stack=1 vectors=1 dtb=1 ram=1 reconciled=1",
          "PASS early physical exclusions regions=0 roots=0",
          "PASS synchronization",
          "PASS allocator retained without retirement or mapping",
          "PASS bootstrap-foundation pend=1 pool=1 retained=1 refund=1 generation=1 stale=1 revoked=1",
          "PASS foundation-pressure preflight=1 fragments=1 allocation=1 pool=1 history=1 rediscover=1 shut=1",
          "PASS boot-mapped-storage identity=1 range=1 rw=1 reuse=1"
        ]
      }
    }
  }
}
