{
  "id": "platform-boot",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/entry/boot/**",
    "server/src/metal/allocator/**",
    "server/src/metal/mmu/internal/access.rs",
    "server/src/metal/mmu/internal/mod.rs",
    "server/src/metal/mmu/mod.rs",
    "server/src/metal/identity/**",
    "server/src/metal/mod.rs",
    "server/src/metal/boot/minor.rs",
    "server/src/metal/boot/mod.rs",
    "server/src/metal/boot/major.rs",
    "server/src/metal/boot/trap.rs",
    "server/src/metal/firmware/mod.rs",
    "server/src/metal/firmware/map.rs",
    "server/src/metal/firmware/acpi/**",
    "server/src/metal/firmware/uefi/**",
    "server/src/metal/boot/console.rs",
    "server/src/metal/boot/services.rs",
    "server/src/metal/firmware/devicetree/**",
    "server/src/devicetree/**",
    "server/src/metal/firmware/facts.rs",
    "server/src/metal/hart/mod.rs",
    "server/src/metal/hart/local/**",
    "server/src/metal/sync/**",
    "server/tests/target/entry/synchronization.rs",
    "server/tests/target/entry/memory.rs",
    "server/tests/target/entry/foundation.rs",
    "server/src/basis/pend.rs"
  ],
  "run": {
    "kind": "board-boot",
    "boards": [
      "q35",
      "virt"
    ],
    "board_sources": {
      "q35": [
        "server/src/metal/boot/x86_64/**",
        "server/tests/target/entry/platforms/q35.rs",
        "server/tests/target/entry/platforms/io.rs",
        "server/src/metal/hart/x86_64.rs"
      ],
      "virt": [
        "server/src/metal/boot/aarch64/**",
        "server/tests/target/entry/platforms/virt.rs",
        "server/tests/target/entry/platforms/devicetree.rs",
        "server/tests/target/entry/platforms/pl011.rs",
        "server/src/metal/firmware/psci/**",
        "server/src/metal/firmware/arm/**",
        "server/src/metal/hart/aarch64/**"
      ]
    }
  }
}
