{
  "id": "platform-boot",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/entry/boot/**",
    "server/src/metal/mod.rs",
    "server/src/metal/generic/boot/minor.rs",
    "server/src/metal/generic/mod.rs",
    "server/src/metal/generic/boot/mod.rs",
    "server/src/metal/generic/boot/major.rs",
    "server/src/metal/generic/firmware/mod.rs",
    "server/src/metal/generic/firmware/map.rs",
    "server/src/metal/generic/firmware/uefi/**",
    "server/src/metal/generic/stack.rs",
    "server/src/metal/generic/console.rs",
    "server/src/metal/generic/services.rs",
    "server/src/metal/generic/devicetree.rs"
  ],
  "run": {
    "kind": "board-boot",
    "boards": [
      "q35",
      "virt"
    ],
    "board_sources": {
      "q35": [
        "server/src/metal/x86_64/**",
        "server/tests/target/entry/platforms/q35.rs",
        "server/tests/target/entry/platforms/io.rs"
      ],
      "virt": [
        "server/src/metal/aarch64/**",
        "server/tests/target/entry/platforms/virt.rs",
        "server/tests/target/entry/platforms/pl011.rs",
        "server/src/metal/generic/firmware/psci.rs"
      ]
    }
  }
}
