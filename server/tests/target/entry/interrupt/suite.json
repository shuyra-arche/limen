{
  "id": "rv64-interrupt",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/platform/mod.rs",
    "server/src/metal/processor/mod.rs",
    "server/src/metal/platform/boot/mod.rs",
    "server/src/metal/platform/boot/major.rs",
    "server/src/metal/platform/boot/trap.rs",
    "server/src/metal/platform/description/mod.rs",
    "server/src/metal/platform/firmware/mod.rs",
    "server/src/metal/platform/firmware/uefi/map.rs",
    "server/src/metal/platform/description/acpi/**",
    "server/src/entry/boot/**",
    "server/src/metal/platform/boot/riscv/**",
    "server/src/metal/platform/firmware/sbi/**",
    "server/link.x",
    "server/src/metal/platform/boot/console.rs",
    "server/src/metal/platform/boot/services.rs",
    "server/src/metal/platform/description/devicetree/**",
    "server/src/devicetree/**",
    "server/src/metal/platform/boot/handoff/mod.rs",
    "server/src/metal/processor/hart/mod.rs",
    "server/src/metal/processor/hart/local/**",
    "server/src/metal/processor/hart/riscv/description.rs",
    "server/src/metal/processor/hart/riscv/mod.rs",
    "server/src/metal/processor/hart/riscv/native.rs",
    "server/src/metal/platform/firmware/uefi/mod.rs",
    "server/src/metal/platform/boot/handoff/sbi.rs",
    "server/src/metal/interrupt/mod.rs",
    "server/src/metal/interrupt/internal/mod.rs",
    "server/src/metal/interrupt/external/**",
    "server/src/metal/interrupt/internal/aclint/mod.rs",
    "server/src/metal/interrupt/internal/aclint/timer/**",
    "server/src/metal/chrono/mod.rs",
    "server/src/metal/chrono/riscv/**",
    "server/src/metal/sync/**",
    "server/src/metal/identity/**",
    "server/src/metal/memory/mod.rs"
  ],
  "run": {
    "kind": "qemu",
    "kernel": "rv64-interrupt",
    "machine": "aplic-aclint",
    "harts": 1,
    "expects": [
      "PASS aclint-timer received=2 cleared=2",
      "PASS aplic-direct received=2 cleared=2 stale=1 shutdown=1"
    ]
  }
}
