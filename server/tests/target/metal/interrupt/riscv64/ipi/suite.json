  "run": {
    "kind": "qemu",
    "kernel": "rv64-ipi",
    "harts": 2,
    "expects": [
      "PASS rv64-ipi original-hart=1 issued=3 rechecked=2 cleared=2 shut=1"
    ],
    "imports": [
      "target/support/riscv64",
      "target/support/ipi.rs"
    ]
  }
