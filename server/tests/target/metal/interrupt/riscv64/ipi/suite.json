{
  "id": "rv64-ipi",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/lib.rs",
    "server/src/entry/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/memory/mod.rs",
    "server/src/metal/platform/mod.rs",
    "server/src/metal/processor/mod.rs",
    "server/src/metal/platform/boot/mod.rs",
    "server/src/metal/platform/boot/major.rs",
    "server/src/metal/platform/boot/trap.rs",
    "server/src/metal/platform/description/mod.rs",
    "server/src/metal/platform/firmware/mod.rs",
    "server/src/metal/platform/firmware/uefi/map.rs",
    "server/src/metal/platform/description/acpi/mod.rs",
    "server/src/entry/boot/**",
    "server/src/metal/memory/mmu/mod.rs",
    "server/src/metal/memory/mmu/riscv64/internal/mod.rs",
    "server/src/metal/memory/mmu/riscv64/internal/description.rs",
    "server/src/metal/processor/hart/riscv64/description.rs",
    "server/src/metal/platform/boot/riscv64/**",
    "server/src/metal/platform/firmware/sbi/**",
    "server/src/metal/platform/boot/riscv64/linker.ld",
    "server/src/metal/platform/boot/console.rs",
    "server/src/metal/platform/boot/services.rs",
    "server/src/metal/platform/description/devicetree/**",
    "server/src/metal/platform/boot/handoff/mod.rs",
    "server/src/metal/processor/hart/mod.rs",
    "server/src/metal/processor/hart/local/**",
    "server/src/metal/processor/hart/riscv64/mod.rs",
    "server/src/metal/processor/hart/riscv64/native.rs",
    "server/src/metal/sync/**",
    "server/src/metal/platform/firmware/uefi/mod.rs",
    "server/src/metal/platform/boot/handoff/sbi.rs",
    "server/src/metal/processor/hart/riscv64/status.rs",
    "server/src/metal/interrupt/mod.rs",
    "server/src/metal/interrupt/riscv64/mod.rs",
    "server/src/metal/interrupt/riscv64/internal/mod.rs",
    "server/src/metal/interrupt/riscv64/internal/supervisor.rs",
    "server/src/metal/memory/mmu/riscv64/internal/context/**",
    "server/src/metal/memory/mmu/riscv64/sv/**",
    "server/src/metal/memory/mmu/riscv64/internal/pte.rs",
    "server/src/metal/interrupt/riscv64/external/mod.rs",
    "server/tests/target/support/riscv64/reception.rs",
    "server/tests/target/support/ipi.rs",
    "server/src/metal/interrupt/ipi.rs",
    "server/src/metal/interrupt/riscv64/internal/ipi.rs",
    "server/src/metal/chrono/clock.rs",
    "server/src/metal/chrono/mod.rs",
    "server/src/metal/chrono/riscv64/**",
    "server/src/metal/platform/boot/minor.rs"
