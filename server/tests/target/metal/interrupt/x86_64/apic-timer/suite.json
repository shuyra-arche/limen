        "server/src/metal/interrupt/x86_64/internal/apic/**",
        "server/src/metal/platform/description/acpi/madt.rs",
        "server/tests/target/support/uefi/interrupt.rs"
      ]
    },
    "launch": {
      "q35": {
        "expects": [
          "PASS local-apic-timer inherited=1 one-shot=1 received=1 eoi=1 stopped=1 released=1"
        ]
      }
    }
