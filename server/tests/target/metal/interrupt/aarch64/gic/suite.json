{
  "id": "aarch64-gic",
  "profiles": [
    "debug",
    "release"
  ],
  "sources": [
    "server/src/entry/boot/**",
    "server/src/entry/mod.rs",
    "server/src/lib.rs",
    "server/src/metal/platform/description/devicetree/**",
    "server/src/metal/memory/mod.rs",
    "server/src/metal/mod.rs",
    "server/src/metal/platform/boot/console.rs",
    "server/src/metal/platform/boot/handoff/mod.rs",
    "server/src/metal/platform/boot/handoff/uefi.rs",
    "server/src/metal/platform/boot/major.rs",
    "server/src/metal/platform/boot/mod.rs",
    "server/src/metal/platform/boot/services.rs",
    "server/src/metal/platform/boot/trap.rs",
    "server/src/metal/platform/description/acpi/mod.rs",
    "server/src/metal/platform/description/mod.rs",
    "server/src/metal/platform/firmware/mod.rs",
    "server/src/metal/platform/firmware/uefi/**",
    "server/src/metal/platform/firmware/uefi/map.rs",
    "server/src/metal/platform/firmware/uefi/mod.rs",
    "server/src/metal/platform/mod.rs",
    "server/src/metal/processor/hart/local/**",
    "server/src/metal/processor/hart/mod.rs",
    "server/src/metal/processor/mod.rs",
    "server/tests/target/support/uefi/Cargo.lock",
    "server/tests/target/support/uefi/Cargo.toml",
    "server/tests/target/support/uefi/build.rs",
    "server/tests/target/support/uefi/main.rs",
    "server/tests/target/support/uefi/run.sh",
    "server/src/metal/sync/**"
  ],
  "run": {
    "kind": "board-boot",
    "boards": [
      "virt"
    ],
    "launcher": "support/uefi/run.sh",
    "board_sources": {
      "virt": [
        "server/src/metal/platform/boot/aarch64/**",
        "server/src/metal/platform/firmware/psci/**",
        "server/src/metal/processor/hart/aarch64/**",
        "server/tests/target/support/uefi/virt.rs",
        "server/tests/target/support/uefi/devicetree.rs",
        "server/tests/target/support/uefi/pl011.rs",
        "server/src/metal/interrupt/mod.rs",
        "server/src/metal/interrupt/aarch64/mod.rs",
        "server/src/metal/interrupt/aarch64/internal/mod.rs",
        "server/src/metal/memory/mmu/access/**",
        "server/src/metal/memory/mmu/mod.rs",
        "server/src/metal/interrupt/aarch64/gic/**",
        "server/src/metal/interrupt/aarch64/gic/external/**",
        "server/src/metal/interrupt/aarch64/gic/mod.rs",
        "server/src/metal/interrupt/aarch64/gic/external/mod.rs"
      ]
    },
    "launch": {
      "virt": {
        "secondary_serial": true,
        "features": [
          "gic"
        ],
        "expects": [
          "PASS virt interrupt uart-primary=2 uart-secondary=2 shared-words=1 iar=4 eoi=4 dir=2 masked=1"
        ]
      }
    }
  }
}
